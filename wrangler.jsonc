{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "abbasmaleki",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8b1941f3-3f14-4896-924e-5ecfb5bde69c","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "eb93599c5ee4457e943d2bb0fa0ffc48" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
